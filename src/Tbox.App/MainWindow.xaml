<Window
    x:Class="Tbox.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <NavigationView x:Name="RootNavigation"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="概览" Tag="overview">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="文件夹跳转" Tag="folder-jump">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Padding="12" Spacing="4">
                    <TextBlock Text="Tbox" FontWeight="SemiBold"/>
                    <TextBlock Text="Windows 效率工具箱" Opacity="0.65" FontSize="12"/>
                    <TextBlock x:Name="VersionText" Text="版本 --" Opacity="0.5" FontSize="11"/>
                </StackPanel>
            </NavigationView.PaneFooter>
            <ScrollViewer>
                <Grid Padding="36,28" MaxWidth="940" HorizontalAlignment="Stretch">
                    <StackPanel x:Name="OverviewPanel" Spacing="18">
                        <TextBlock Text="欢迎使用 Tbox" Style="{StaticResource TitleTextBlockStyle}"/>
                        <TextBlock Text="一个承载各种 Windows 小工具的模块化底座。" Opacity="0.72"/>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <FontIcon Glyph="&#xE8B7;" FontSize="24"/>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="文件夹跳转" FontWeight="SemiBold"/>
                                    <TextBlock Text="让标准文件对话框跳转到最近使用的资源管理器目录。" Opacity="0.68"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" x:Name="OverviewStatus" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="FolderJumpPanel" Spacing="18" Visibility="Collapsed">
                        <TextBlock Text="文件夹跳转" Style="{StaticResource TitleTextBlockStyle}"/>
                        <TextBlock Text="在打开或保存文件时，快速跳转到你刚刚浏览的文件夹。" Opacity="0.72"/>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="启用文件夹跳转" FontWeight="SemiBold"/>
                                    <TextBlock Text="全局监听快捷键并记录最近使用的资源管理器目录。" Opacity="0.65"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="EnabledToggle" Grid.Column="1" Toggled="OnEnabledToggled"/>
                            </Grid>
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="快捷键" FontWeight="SemiBold"/>
                                    <TextBlock Text="首版固定为 Ctrl + G；后续将提供快捷键录制器。" Opacity="0.65"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="HotkeyButton" Content="Ctrl + G" IsEnabled="False"/>
                            </Grid>
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="开机启动" FontWeight="SemiBold"/>
                                    <TextBlock Text="登录 Windows 后自动运行 Tbox。" Opacity="0.65"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" Toggled="OnStartupToggled"/>
                            </Grid>
                        </Border>
                        <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
