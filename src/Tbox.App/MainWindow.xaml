<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tbox.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}" RowDefinitions="54,*">
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="54"
              Padding="10,0,142,0"
              Background="{ThemeResource TitleBarBackgroundBrush}"
              ColumnDefinitions="240,*">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Button x:Name="PaneToggleButton"
                        Width="36" Height="36" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="OnPaneToggleClicked"
                        ToolTipService.ToolTip="打开导航">
                    <FontIcon Glyph="&#xE700;" FontSize="18"/>
                </Button>
                <Image x:Name="TitleAppIcon" Source="Assets/AppIcon.png" Width="24" Height="24"/>
                <TextBlock x:Name="TitleBrandText"
                           Text="Tbox 设置"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <AutoSuggestBox x:Name="SettingsSearchBox"
                            Grid.Column="1"
                            MaxWidth="640"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            PlaceholderText="搜索设置"
                            QuerySubmitted="OnSearchQuerySubmitted">
                <AutoSuggestBox.QueryIcon>
                    <SymbolIcon Symbol="Find"/>
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
        </Grid>

        <NavigationView x:Name="RootNavigation"
                        Grid.Row="1"
                        Background="{ThemeResource AppBackgroundBrush}"
                        PaneDisplayMode="Auto"
                        IsPaneOpen="True"
                        OpenPaneLength="240"
                        CompactPaneLength="0"
                        CompactModeThresholdWidth="1000"
                        ExpandedModeThresholdWidth="1000"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        AlwaysShowHeader="False"
                        SelectionChanged="OnNavigationSelectionChanged"
                        DisplayModeChanged="OnNavigationDisplayModeChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="主页" Tag="home">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="常规" Tag="general">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator/>
                <NavigationViewItemHeader Content="实用工具"/>
                <NavigationViewItem Content="文件夹跳转" Tag="folder-jump">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Folder"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="截图与贴图" Tag="screen-paste">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEB9F;"/></NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge><InfoBadge Value="1"/></NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Padding="8,10,8,12" Spacing="2">
                    <Rectangle Height="1" Fill="{ThemeResource DividerBrush}" Margin="0,0,0,8"/>
                    <Button Style="{StaticResource FooterButtonStyle}" Click="OnWelcomeClicked">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE946;" FontSize="17"/>
                            <TextBlock Text="欢迎使用 Tbox" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FooterButtonStyle}" Click="OnWhatsNewClicked">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE7C3;" FontSize="17"/>
                            <TextBlock Text="新增内容" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FooterButtonStyle}" Click="OnFeedbackClicked">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE939;" FontSize="17"/>
                            <TextBlock Text="提供反馈" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid x:Name="PageHost" SizeChanged="OnPageHostSizeChanged">
                <ScrollViewer x:Name="HomePanel"
                              HorizontalContentAlignment="Stretch"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Padding="28,24,28,48" MaxWidth="1180" HorizontalAlignment="Center">
                        <StackPanel Spacing="20">
                            <Grid x:Name="HomeHeaderGrid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="主页" Style="{StaticResource PageTitleStyle}"/>
                                    <TextBlock Text="高频操作和工具状态集中在一个页面" Style="{StaticResource BodyTextStyle}" Foreground="{ThemeResource SubtleTextBrush}"/>
                                </StackPanel>
                                <StackPanel x:Name="HomeSignals" Grid.Column="1" Orientation="Horizontal" Spacing="28" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon Glyph="&#xE765;" FontSize="18" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="快捷键冲突" Style="{StaticResource BodyTextStyle}"/>
                                            <TextBlock x:Name="ShortcutConflictText" Text="未找到冲突" Style="{StaticResource CaptionTextStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="当前版本" Style="{StaticResource BodyTextStyle}"/>
                                            <TextBlock x:Name="HomeVersionText" Text="--" Style="{StaticResource CaptionTextStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="HomeMainGrid" ColumnDefinitions="*,340" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                                <StackPanel x:Name="HomeLeftColumn" Spacing="14">
                                    <Border Style="{StaticResource CardStyle}" Padding="16">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="快速访问" Style="{StaticResource SectionTitleStyle}"/>
                                            <Grid x:Name="QuickActionGrid" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                                <Button x:Name="StartCaptureButton" Style="{StaticResource QuickActionButtonStyle}" Click="OnStartCaptureClicked">
                                                    <StackPanel HorizontalAlignment="Center" Spacing="7">
                                                        <FontIcon Glyph="&#xEB9F;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                        <TextBlock Text="开始截图" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="F6" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="PasteClipboardButton" Grid.Column="1" Style="{StaticResource QuickActionButtonStyle}" Click="OnPasteClipboardClicked">
                                                    <StackPanel HorizontalAlignment="Center" Spacing="7">
                                                        <FontIcon Glyph="&#xF0E3;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                        <TextBlock Text="剪贴板贴图" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="F7" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="OpenFolderToolButton" Grid.Column="2" Style="{StaticResource QuickActionButtonStyle}" Click="OnOpenFolderToolClicked">
                                                    <StackPanel HorizontalAlignment="Center" Spacing="7">
                                                        <FontIcon Glyph="&#xE8B7;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                        <TextBlock Text="文件夹跳转" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="Ctrl + G" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="快捷键" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                                            <Grid MinHeight="43" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="开始截图" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Foreground="{ThemeResource SubtleTextBrush}"/>
                                                <Button Grid.Column="1" Content="F6" IsEnabled="False"/>
                                            </Grid>
                                            <Rectangle Height="1" Fill="{ThemeResource DividerBrush}"/>
                                            <Grid MinHeight="43" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="剪贴板贴图" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Foreground="{ThemeResource SubtleTextBrush}"/>
                                                <Button Grid.Column="1" Content="F7" IsEnabled="False"/>
                                            </Grid>
                                            <Rectangle Height="1" Fill="{ThemeResource DividerBrush}"/>
                                            <Grid MinHeight="43" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="显示 / 隐藏全部贴图" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Foreground="{ThemeResource SubtleTextBrush}"/>
                                                <Button Grid.Column="1" Content="F8" IsEnabled="False"/>
                                            </Grid>
                                            <Rectangle Height="1" Fill="{ThemeResource DividerBrush}"/>
                                            <Grid MinHeight="43" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="跳转到最近目录" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Foreground="{ThemeResource SubtleTextBrush}"/>
                                                <Button Grid.Column="1" x:Name="HomeFolderHotkeyButton" Content="Ctrl + G" IsEnabled="False"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border x:Name="HomeUtilitiesCard" Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <Grid MinHeight="54" Padding="15,0" ColumnDefinitions="*,Auto">
                                            <TextBlock Text="实用程序" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" x:Name="EnabledToolCountText" Text="--" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Rectangle Height="1" Fill="{ThemeResource DividerBrush}"/>
                                        <Grid MinHeight="76" Padding="14,10" ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="21" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="文件夹跳转" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                                <TextBlock Text="快速定位最近目录" Style="{StaticResource CaptionTextStyle}"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="HomeFolderToggle" Grid.Column="2" Toggled="OnHomeFolderToggled" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Rectangle Height="1" Fill="{ThemeResource DividerBrush}"/>
                                        <Grid MinHeight="76" Padding="14,10" ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                                            <FontIcon Glyph="&#xEB9F;" FontSize="21" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="截图与贴图" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                                <TextBlock Text="截图、标注并固定图像" Style="{StaticResource CaptionTextStyle}"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="HomeScreenPasteToggle" Grid.Column="2" Toggled="OnHomeScreenPasteToggled" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="GeneralPanel"
                              Visibility="Collapsed"
                              HorizontalContentAlignment="Stretch"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Padding="28,24,28,48" MaxWidth="1120" HorizontalAlignment="Center">
                        <StackPanel Spacing="0">
                            <StackPanel Spacing="4" Margin="0,0,0,20">
                                <TextBlock Text="常规" Style="{StaticResource PageTitleStyle}"/>
                                <TextBlock Text="管理 Tbox 的更新、外观和应用行为" Style="{StaticResource BodyTextStyle}" Foreground="{ThemeResource SubtleTextBrush}"/>
                            </StackPanel>

                            <TextBlock Text="版本和更新" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,9"/>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid x:Name="VersionRowGrid" MinHeight="76" Padding="16,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,0" ColumnSpacing="20">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE895;" FontSize="19"/>
                                        <StackPanel>
                                            <TextBlock x:Name="VersionText" Text="Tbox --" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                            <TextBlock Text="上次检查：刚刚" Style="{StaticResource CaptionTextStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button x:Name="CheckUpdateButton" Grid.Column="1" Content="检查更新" Click="OnCheckUpdateClicked" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <InfoBar x:Name="UpdateInfoBar"
                                     Margin="0,6,0,0"
                                     IsOpen="True"
                                     IsClosable="False"
                                     Severity="Success"
                                     Title="已安装最新版本"
                                     Message="Tbox 会定期检查可用更新"/>

                            <TextBlock Text="外观和行为" Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,9"/>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid x:Name="LanguageRowGrid" MinHeight="72" Padding="16,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,0" ColumnSpacing="20">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xF2B7;" FontSize="19"/>
                                            <StackPanel>
                                                <TextBlock Text="语言" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                                <TextBlock Text="默认情况下，Tbox 与 Windows 语言匹配" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="250" SelectedIndex="0" IsEnabled="False">
                                            <ComboBoxItem Content="Windows 默认"/>
                                        </ComboBox>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{ThemeResource DividerBrush}"/>
                                    <Grid x:Name="ThemeRowGrid" MinHeight="72" Padding="16,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,0" ColumnSpacing="20">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE790;" FontSize="19"/>
                                            <StackPanel>
                                                <TextBlock Text="主题" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                                <TextBlock Text="跟随 Windows，或单独选择浅色和深色" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <ComboBox x:Name="ThemeComboBox" Grid.Column="1" Width="250" SelectionChanged="OnThemeSelectionChanged">
                                            <ComboBoxItem Content="Windows 默认" Tag="system"/>
                                            <ComboBoxItem Content="浅色" Tag="light"/>
                                            <ComboBoxItem Content="深色" Tag="dark"/>
                                        </ComboBox>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{ThemeResource DividerBrush}"/>
                                    <Grid x:Name="StartupRowGrid" MinHeight="72" Padding="16,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,0" ColumnSpacing="20">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7E8;" FontSize="19"/>
                                            <StackPanel>
                                                <TextBlock Text="开机自启动" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                                <TextBlock Text="登录 Windows 后自动运行 Tbox" Style="{StaticResource CaptionTextStyle}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" OnContent="开" OffContent="关" Toggled="OnStartupToggled"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{ThemeResource DividerBrush}"/>
                                    <Grid x:Name="NotificationsRowGrid" MinHeight="72" Padding="16,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,0" ColumnSpacing="20">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xEA8F;" FontSize="19"/>
                                            <StackPanel>
                                                <TextBlock Text="显示功能问题警告" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                                <TextBlock Text="工具运行异常或权限不足时显示系统通知" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="FailureNotificationsToggle" Grid.Column="1" OnContent="开" OffContent="关" Toggled="OnFailureNotificationsToggled"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{ThemeResource DividerBrush}"/>
                                    <Grid x:Name="TrayRowGrid" MinHeight="72" Padding="16,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,0" ColumnSpacing="20">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7F4;" FontSize="19"/>
                                            <StackPanel>
                                                <TextBlock Text="显示系统托盘图标" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Tbox 常驻后台时用于重新打开设置" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="TrayToggle" Grid.Column="1" IsOn="True" IsEnabled="False" OnContent="开" OffContent="关"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="快捷键" Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,9"/>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid x:Name="ConflictRowGrid" MinHeight="72" Padding="16,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,0" ColumnSpacing="20">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE765;" FontSize="19"/>
                                            <StackPanel>
                                                <TextBlock Text="快捷键冲突检测" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="ConflictDetailText" Text="当前未发现与其他应用冲突的快捷方式" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button x:Name="CheckShortcutsButton" Grid.Column="1" Content="重新检测" Click="OnCheckShortcutsClicked"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{ThemeResource DividerBrush}"/>
                                    <Grid x:Name="FolderHotkeyRowGrid" MinHeight="72" Padding="16,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,0" ColumnSpacing="20">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8D7;" FontSize="19"/>
                                            <StackPanel>
                                                <TextBlock Text="文件夹跳转快捷键" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                                <TextBlock Text="在标准文件对话框中跳转到最近目录" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button x:Name="GeneralHotkeyButton" Grid.Column="1" Content="Ctrl + G" IsEnabled="False"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="FolderJumpPanel"
                              Visibility="Collapsed"
                              HorizontalContentAlignment="Stretch"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Padding="28,24,28,48" MaxWidth="960" HorizontalAlignment="Center">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock Text="文件夹跳转" Style="{StaticResource PageTitleStyle}"/>
                                <TextBlock Text="在打开或保存文件时，快速跳转到刚刚浏览的文件夹" Style="{StaticResource BodyTextStyle}" Foreground="{ThemeResource SubtleTextBrush}"/>
                            </StackPanel>
                            <Border Style="{StaticResource CardStyle}" Padding="18">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="启用文件夹跳转" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                        <TextBlock Text="全局监听快捷键并记录最近使用的资源管理器目录" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="EnabledToggle" Grid.Column="1" Toggled="OnEnabledToggled"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Padding="18">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="快捷键" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                        <TextBlock Text="当前使用 Ctrl + G" Style="{StaticResource CaptionTextStyle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="HotkeyButton" Content="Ctrl + G" IsEnabled="False"/>
                                </Grid>
                            </Border>
                            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="ScreenPastePanel"
                              Visibility="Collapsed"
                              HorizontalContentAlignment="Stretch"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Padding="28,24,28,48" MaxWidth="960" HorizontalAlignment="Center">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock Text="截图与贴图" Style="{StaticResource PageTitleStyle}"/>
                                <TextBlock Text="F6 截图，F7 贴出剪贴板图片或文字，F8 显示或隐藏全部贴图" Style="{StaticResource BodyTextStyle}" Foreground="{ThemeResource SubtleTextBrush}"/>
                            </StackPanel>
                            <Border Style="{StaticResource CardStyle}" Padding="18">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="启用截图与贴图" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                        <TextBlock Text="注册全局快捷键；关闭模块会关闭贴图，但保留截图缓存" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ScreenPasteToggle" Grid.Column="1" Toggled="OnScreenPasteToggled"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Padding="18">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                    <StackPanel Spacing="3"><TextBlock Text="一次截图" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/><TextBlock Text="框选后可拖动四边或四角继续调整；中键可直接完成并固定" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/></StackPanel>
                                    <Button Grid.Column="1" Content="F6" IsEnabled="False"/>
                                    <StackPanel Grid.Row="1" Spacing="3"><TextBlock Text="贴出剪贴板内容" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/><TextBlock Text="读取剪贴板中的图片或文字并新建贴图" Style="{StaticResource CaptionTextStyle}"/></StackPanel>
                                    <Button Grid.Row="1" Grid.Column="1" Content="F7" IsEnabled="False"/>
                                    <StackPanel Grid.Row="2" Spacing="3"><TextBlock Text="整体显示 / 隐藏" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/><TextBlock Text="统一隐藏或恢复全部贴图" Style="{StaticResource CaptionTextStyle}"/></StackPanel>
                                    <Button Grid.Row="2" Grid.Column="1" Content="F8" IsEnabled="False"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Padding="18">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                                    <StackPanel Spacing="4"><TextBlock Text="截图缓存文件夹" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/><TextBlock Text="新截图会保存到这里；更换目录不会移动已有文件" Style="{StaticResource CaptionTextStyle}"/></StackPanel>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <TextBox x:Name="CacheDirectoryTextBox" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1" Content="更改…" Click="OnChangeCacheFolderClicked"/>
                                        <Button Grid.Column="2" Content="打开文件夹" Click="OnOpenCacheFolderClicked"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Padding="18">
                                <StackPanel Spacing="4"><TextBlock Text="贴图操作" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/><TextBlock Text="拖动贴图可移动，滚轮缩放；空格或右键可在贴图外显示标注工具条；Ctrl+C 复制，Esc 逐级取消或关闭。" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                            <InfoBar x:Name="ScreenPasteStatusBar" IsOpen="False" IsClosable="True"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <InfoBar x:Name="GlobalInfoBar"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Width="380"
                         Margin="16"
                         IsOpen="False"
                         IsClosable="True"/>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
