<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <TboxWindows Condition="'$(TboxWindows)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">true</TboxWindows>
    <TargetFramework Condition="'$(TboxWindows)' == 'true'">net8.0-windows10.0.26100.0</TargetFramework>
    <EnableWindowsTargeting Condition="'$(TboxWindows)' == 'true'">true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion Condition="'$(TboxWindows)' == 'true'">10.0.19041.0</SupportedOSPlatformVersion>
    <Platform Condition="'$(TboxWindows)' == 'true' and ('$(Platform)' == '' or '$(Platform)' == 'AnyCPU')">x64</Platform>
    <PlatformTarget Condition="'$(TboxWindows)' == 'true'">$(Platform)</PlatformTarget>
    <Version>1.1.45</Version>
    <AssemblyVersion>1.1.45.0</AssemblyVersion>
    <FileVersion>1.1.45.0</FileVersion>
    <TboxWindowsFfmpegRoot>$(MSBuildThisFileDirectory)../../TEMP/media-runtime/windows</TboxWindowsFfmpegRoot>
    <ApplicationIcon Condition="'$(TboxWindows)' == 'true'">Assets/Tbox.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.2" />
    <ProjectReference Include="../Tbox.Core/Tbox.Core.csproj" />
    <AvaloniaResource Include="Assets/WindowsTrayIcon.ico" />
    <AvaloniaResource Include="Assets/StoreLogo.png" />
    <AvaloniaResource Include="Platform/macos/menu-bar-icon.png" Link="Assets/MenuBarIcon.png" />
    <Content Include="ThirdParty/**" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="Tbox.Desktop.Tests" />
    <InternalsVisibleTo Include="Tbox.FolderSmoke" />
    <InternalsVisibleTo Include="Tbox.MediaSmoke" />
    <EmbeddedResource Include="Updates/install-macos-update.sh" />
  </ItemGroup>
  <ItemGroup Condition="'$(TboxWindows)' == 'true'">
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <Content Include="$(TboxWindowsFfmpegRoot)/**" Link="ThirdParty/FFmpeg/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireWindowsExporter" BeforeTargets="PrepareForBuild" Condition="'$(TboxWindows)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(TboxWindowsFfmpegRoot)/bin/ffmpeg.exe')" Text="Prepare the verified Windows media runtime in TEMP/media-runtime/windows. See docs/automatic-releases.md." />
  </Target>
</Project>
