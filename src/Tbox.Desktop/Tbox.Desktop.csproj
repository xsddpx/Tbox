<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TboxWindows Condition="'$(TboxWindows)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">true</TboxWindows>
    <TargetFramework Condition="'$(TboxWindows)' == 'true'">net10.0-windows10.0.26100.0</TargetFramework>
    <EnableWindowsTargeting Condition="'$(TboxWindows)' == 'true'">true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion Condition="'$(TboxWindows)' == 'true'">10.0.22000.0</SupportedOSPlatformVersion>
    <Platform Condition="'$(TboxWindows)' == 'true' and ('$(Platform)' == '' or '$(Platform)' == 'AnyCPU')">x64</Platform>
    <PlatformTarget Condition="'$(TboxWindows)' == 'true'">$(Platform)</PlatformTarget>
    <Version>1.1.129</Version>
    <AssemblyVersion>1.1.129.0</AssemblyVersion>
    <FileVersion>1.1.129.0</FileVersion>
    <TBOX_ACCOUNT_ORIGIN Condition="'$(TBOX_ACCOUNT_ORIGIN)' == ''">https://tbox.xsddpx.com/</TBOX_ACCOUNT_ORIGIN>
    <TboxWindowsFfmpegRoot>$(MSBuildThisFileDirectory)../../TEMP/media-runtime/windows</TboxWindowsFfmpegRoot>
    <ApplicationIcon Condition="'$(TboxWindows)' == 'true'">Assets/Tbox.ico</ApplicationIcon>
    <ApplicationManifest Condition="'$(TboxWindows)' == 'true'">Platform/windows/app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="TboxAccountOrigin" Value="$(TBOX_ACCOUNT_ORIGIN)" Condition="'$(TBOX_ACCOUNT_ORIGIN)' != ''" />
    <AssemblyMetadata Include="TboxRemoteRendezvous" Value="$(TBOX_REMOTE_RENDEZVOUS)" Condition="'$(TBOX_REMOTE_RENDEZVOUS)' != ''" />
    <AssemblyMetadata Include="TboxRemoteRendezvousKey" Value="$(TBOX_REMOTE_RENDEZVOUS_KEY)" Condition="'$(TBOX_REMOTE_RENDEZVOUS_KEY)' != ''" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.2" />
    <!-- 速览 text, Markdown and SVG previews. Svg.Skia 3.x is the last line on SkiaSharp 2.88, which Avalonia 11 uses. -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="11.3.0" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Svg.Skia" Version="3.7.0" />
    <PackageReference Include="SharpCompress" Version="0.50.10" />
    <ProjectReference Include="../Tbox.Core/Tbox.Core.csproj" />
    <AvaloniaResource Include="Assets/WindowsTrayIcon.ico" />
    <AvaloniaResource Include="Assets/StoreLogo.png" />
    <AvaloniaResource Include="Platform/macos/menu-bar-icon.png" Link="Assets/MenuBarIcon.png" />
    <Content Include="ThirdParty/**" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="Tbox.Desktop.Tests" />
    <InternalsVisibleTo Include="Tbox.FolderSmoke" />
    <InternalsVisibleTo Include="Tbox.MediaSmoke" />
    <InternalsVisibleTo Include="Tbox.ClipboardSmoke" />
    <EmbeddedResource Include="Updates/install-macos-update.sh" />
  </ItemGroup>
  <ItemGroup Condition="'$(TboxWindows)' == 'true'">
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <Content Include="$(TboxWindowsFfmpegRoot)/**" Link="ThirdParty/FFmpeg/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireWindowsExporter" BeforeTargets="PrepareForBuild" Condition="'$(TboxWindows)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(TboxWindowsFfmpegRoot)/bin/ffmpeg.exe')" Text="Prepare the verified Windows media runtime in TEMP/media-runtime/windows. See docs/automatic-releases.md." />
  </Target>
</Project>
