<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <TboxWindows Condition="'$(TboxWindows)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">true</TboxWindows>
    <TargetFramework Condition="'$(TboxWindows)' == 'true'">net8.0-windows10.0.26100.0</TargetFramework>
    <EnableWindowsTargeting Condition="'$(TboxWindows)' == 'true'">true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion Condition="'$(TboxWindows)' == 'true'">10.0.19041.0</SupportedOSPlatformVersion>
    <Platform Condition="'$(TboxWindows)' == 'true' and ('$(Platform)' == '' or '$(Platform)' == 'AnyCPU')">x64</Platform>
    <PlatformTarget Condition="'$(TboxWindows)' == 'true'">$(Platform)</PlatformTarget>
    <Version>1.1.7</Version>
    <AssemblyVersion>1.1.7.0</AssemblyVersion>
    <FileVersion>1.1.7.0</FileVersion>
    <ApplicationIcon Condition="'$(TboxWindows)' == 'true'">../Tbox.App/Assets/Tbox.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.2" />
    <ProjectReference Include="../Tbox.Core/Tbox.Core.csproj" />
    <AvaloniaResource Include="../Tbox.App/Assets/AppIcon.png" Link="Assets/AppIcon.png" />
    <Content Include="ThirdParty/**" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Tbox.App/AppLog.cs" Link="Platform/AppLog.cs" />
    <InternalsVisibleTo Include="Tbox.Desktop.Tests" />
    <InternalsVisibleTo Include="Tbox.MediaSmoke" />
    <EmbeddedResource Include="Updates/install-macos-update.sh" />
  </ItemGroup>
  <ItemGroup Condition="'$(TboxWindows)' == 'true'">
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <Compile Include="../Tbox.App/ScreenRegionRecorder.cs" Link="Platform/windows/ScreenRegionRecorder.cs" />
    <Compile Include="../Tbox.App/NativeMethods.cs" Link="Platform/windows/LegacyNativeMethods.cs" />
    <Compile Include="../Tbox.App/ExplorerFolderTracker.cs" Link="Platform/windows/ExplorerFolderTracker.cs" />
    <Compile Include="../Tbox.App/ExplorerShellViewResolver.cs" Link="Platform/windows/ExplorerShellViewResolver.cs" />
    <Compile Include="../Tbox.App/FileDialogNavigator.cs" Link="Platform/windows/FileDialogNavigator.cs" />
    <Content Include="../Tbox.App/ThirdParty/FFmpeg/**" Link="ThirdParty/FFmpeg/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
